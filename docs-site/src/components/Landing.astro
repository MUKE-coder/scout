---
import { Code } from "@astrojs/starlight/components";
import { SCOUT_VERSION, RELEASE_HEADLINE, RELEASE_URL, REPO_URL } from "../version";
import prompt from "../prompts/build-with-ai.md?raw";

/**
 * The docs home page, Supabase-style: a clean hero, then gridline-framed
 * sections that pair a left-hand heading with a right-hand grid of cards.
 */
const install = [
  { id: "sh", label: "macOS / Linux", command: "curl -fsSL https://scout.codetotech.com/install.sh | sh" },
  { id: "ps", label: "Windows", command: "irm https://scout.codetotech.com/install.ps1 | iex" },
  { id: "go-install", label: "go install", command: "go install github.com/MUKE-coder/scout/cmd/scout@latest" },
  { id: "source", label: "from source", command: "git clone https://github.com/MUKE-coder/scout && cd scout && go build ./cmd/scout" },
  { id: "ai", label: "AI prompt", command: "Paste this into Claude, Cursor, Codex or any coding agent →", copy: prompt, note: true },
];

const capabilities = [
  { icon: "globe", title: "Running app", body: "Black-box scan a live URL for missing headers, exposed files, injection and weak auth." },
  { icon: "code", title: "Code repo", body: "Source & supply-chain: committed secrets, insecure Dockerfiles, reachable Go CVEs." },
  { icon: "ci", title: "CI pipeline", body: "Fail the build on findings at or above a severity, with SARIF for code scanning." },
  { icon: "export", title: "Dashboard & export", body: "A local dashboard, then export findings as Markdown, HTML or text to hand to a developer." },
];

// On-page "how to scan" guide — so a visitor can learn without the docs.
const guides = [
  { id: "local", label: "Local app", desc: "Scan an app running on your machine — full depth, no setup.", code: "scout scan --target http://localhost:3000 --mode active --env dev", note: "Runs every check, including injection and auth probes. Localhost needs no ownership proof." },
  { id: "live", label: "Live site", desc: "Scan a deployed site you own.", code: "scout scan --target https://example.com --mode safe", note: "Safe mode needs nothing. For active probes on a public host, verify ownership first (scout ownership --target …) then add --mode active --allow-active." },
  { id: "repo", label: "Code repo", desc: "Scan source for secrets, Dockerfiles and vulnerable dependencies.", code: "scout scan --repo .", note: "No running app needed — ideal at review time and in CI." },
  { id: "lab", label: "Try the lab", desc: "No target handy? Scan Scout's deliberately-vulnerable demo app.", code: "scout lab", note: "Clones the lab and scans its source in one command, then shows how to scan the running app too." },
  { id: "ci", label: "Gate CI", desc: "Fail a build on findings at or above a severity.", code: "scout ci --repo . --fail-on high --new-only", note: "--new-only fails only on what a change introduced. Add --sarif for GitHub code scanning." },
  { id: "dash", label: "Dashboard", desc: "Explore and export the findings in your browser.", code: "scout scan --target http://localhost:3000 --serve", note: "Scans, then opens the dashboard at http://localhost:9090/scout/ui/ — log in with admin / scout in dev." },
];

// Dashboard screenshots, for the on-page gallery.
const pages = [
  { id: "overview", label: "Overview", img: "/screens/overview.png", cap: "Grade, severity breakdown, categories, Fix next and scan coverage at a glance." },
  { id: "coverage", label: "Scan coverage", img: "/screens/coverage.png", cap: "A progress bar over the diagnostic scans, each with what it checks and a Run button." },
  { id: "findings", label: "Findings", img: "/screens/findings.png", cap: "Every finding, filterable — click one for the cause, evidence and fix. Export menu for MD/HTML/txt." },
  { id: "surface", label: "Attack surface", img: "/screens/surface.png", cap: "A domain → host → service → route map of everything exposed, with finding counts." },
  { id: "compliance", label: "Compliance", img: "/screens/compliance.png", cap: "Open findings mapped onto the OWASP Top 10, and how much Scout's checks cover." },
  { id: "history", label: "History", img: "/screens/history.png", cap: "Every past scan; pick two to diff and see what changed." },
  { id: "settings", label: "Settings", img: "/screens/settings.png", cap: "The configuration Scout is running with, from scout.yaml." },
];

const catches = [
  "Missing security headers & cookie flags",
  "Exposed .env / .git / backups / metrics",
  "Reflected XSS, open redirect, CSRF forms",
  "SQL injection & OS command injection",
  "Weak JWTs, permissive CORS, IDOR",
  "Reachable Go CVEs in dependencies",
  "Hard-coded secrets & insecure Dockerfiles",
  "Version disclosure, directory listings, mixed content",
];

function icon(name: string): string {
  const s = (p: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${p}</svg>`;
  const icons: Record<string, string> = {
    globe: s('<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 2.5 15 0 18M12 3c-2.5 2.5-2.5 15 0 18"/>'),
    code: s('<path d="M8 9l-3 3 3 3M16 9l3 3-3 3M13 7l-2 10"/>'),
    ci: s('<path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 4v4h-4"/><path d="M9 12l2 2 4-4"/>'),
    export: s('<path d="M12 15V3M8 7l4-4 4 4"/><path d="M4 13v6a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-6"/>'),
    check: s('<path d="M4 12.5l5 5 11-12"/>'),
  };
  return icons[name] ?? "";
}
---

<div class="sc-root">
  <div class="sc-bg" aria-hidden="true">
    <div class="sc-grid"></div>
    <div class="sc-glow"></div>
  </div>

  <section class="sc-hero">
    <div class="sc-hero-copy">
      <a class="sc-pill" href={RELEASE_URL} data-anim>
        <span class="sc-pill-tag">v{SCOUT_VERSION}</span>
        <span class="sc-pill-text">{RELEASE_HEADLINE}</span>
      </a>
      <h1 class="sc-title" data-anim>
        The self-hosted scanner
        <span class="sc-accent">for your apps &amp; repos</span>
      </h1>
      <p class="sc-sub" data-anim>
        Point Scout at a running app or a code repository. It maps the attack
        surface, finds the ways in, then grades the result and tells you exactly
        how to fix it — one binary, self-hosted, no account.
      </p>
      <div class="sc-actions" data-anim>
        <a class="sc-btn sc-btn-primary" href="/start/quickstart/">
          Start scanning
          <svg aria-hidden="true" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
        <a class="sc-btn sc-btn-ghost" href={REPO_URL}>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.57.1.78-.25.78-.55v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.3 1.19-3.1-.12-.3-.52-1.47.11-3.07 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.5 3.17-1.18 3.17-1.18.63 1.6.23 2.77.11 3.07.74.8 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.26 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.66.79.55A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"></path></svg>
          View on GitHub
        </a>
      </div>

      <p class="sc-demo" data-anim>
        New here? <code>scout lab</code> clones a vulnerable demo app and scans it in one command.
      </p>
    </div>

    <div class="sc-visual" data-anim>
      <div class="sc-console">
        <div class="sc-radar" aria-hidden="true">
          <svg viewBox="0 0 220 220" width="100%" height="100%">
            <defs>
              <radialGradient id="sweep" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="var(--fl-ember)" stop-opacity="0.55"></stop>
                <stop offset="100%" stop-color="var(--fl-ember)" stop-opacity="0"></stop>
              </radialGradient>
            </defs>
            <g stroke="var(--sc-ring)" fill="none" stroke-width="1">
              <circle cx="110" cy="110" r="100"></circle><circle cx="110" cy="110" r="70"></circle><circle cx="110" cy="110" r="40"></circle>
            </g>
            <line x1="10" y1="110" x2="210" y2="110" stroke="var(--sc-ring)" stroke-width="1"></line>
            <line x1="110" y1="10" x2="110" y2="210" stroke="var(--sc-ring)" stroke-width="1"></line>
            <g class="sc-sweep">
              <path d="M110 110 L110 10 A100 100 0 0 1 180 40 Z" fill="url(#sweep)"></path>
              <line x1="110" y1="110" x2="110" y2="10" stroke="var(--fl-ember)" stroke-width="2"></line>
            </g>
            <circle class="sc-blip sc-blip-1" cx="150" cy="70" r="3.5" fill="var(--sc-crit)"></circle>
            <circle class="sc-blip sc-blip-2" cx="78" cy="150" r="3.5" fill="var(--sc-high)"></circle>
            <circle class="sc-blip sc-blip-3" cx="140" cy="150" r="3" fill="var(--sc-med)"></circle>
            <circle cx="110" cy="110" r="4" fill="var(--fl-ember)"></circle>
          </svg>
        </div>
        <div class="sc-term">
          <div class="sc-term-bar"><span class="sc-dot"></span><span class="sc-dot"></span><span class="sc-dot"></span><span class="sc-term-title">scout</span></div>
          <div class="sc-term-body">
            <div class="sc-line sc-prompt"><span class="sc-dollar">$</span> <span id="sc-typed"></span><span class="sc-caret" id="sc-caret">▋</span></div>
            <div class="sc-out" data-out="0"><span class="sc-tick">✓</span> Crawling application…</div>
            <div class="sc-out" data-out="1"><span class="sc-tick">✓</span> Scanning for vulnerabilities…</div>
            <div class="sc-out" data-out="2"><span class="sc-tick">✓</span> Mapping attack surface…</div>
            <div class="sc-out" data-out="3"><span class="sc-tick">✓</span> Generating report…</div>
            <div class="sc-findings" data-out="4"><span class="sc-chip sc-crit">2 Critical</span><span class="sc-chip sc-high">5 High</span><span class="sc-chip sc-med">8 Medium</span></div>
            <div class="sc-grade-line" data-out="5">Scan complete. Grade <span class="sc-grade">F</span> <span class="sc-score" id="sc-score">17/100</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ dashboard gallery (every page) ============ -->
  <section class="sc-gallery" data-reveal>
    <h2 class="sc-h2 sc-center">Every page of the dashboard</h2>
    <p class="sc-lead-c">Run <code>scout serve</code> or <code>scout scan --serve</code> for an embedded dashboard — explore every page below.</p>
    <div class="g-tabs" role="tablist" aria-label="Dashboard pages">
      {pages.map((p, i) => (
        <button type="button" role="tab" class:list={["g-tab", { active: i === 0 }]} data-tab-group="pages" data-tab={p.id} aria-selected={i === 0 ? "true" : "false"}>{p.label}</button>
      ))}
    </div>
    {pages.map((p, i) => (
      <div class:list={["g-panel", { active: i === 0 }]} data-panel-group="pages" data-panel={p.id}>
        <div class="sc-shot">
          <img src={p.img} alt={`Scout dashboard: ${p.label}`} loading="lazy" width="1262" height="568" />
        </div>
        <p class="sc-shot-cap">{p.cap}</p>
      </div>
    ))}
  </section>

  <!-- ============ how to scan (tabbed guide) ============ -->
  <section class="sc-guide" data-reveal>
    <h2 class="sc-h2 sc-center">How to scan</h2>
    <p class="sc-lead-c">Pick what you're scanning — copy the command and go. No docs trip required.</p>
    <div class="g-tabs" role="tablist" aria-label="How to scan">
      {guides.map((g, i) => (
        <button type="button" role="tab" class:list={["g-tab", { active: i === 0 }]} data-tab-group="guide" data-tab={g.id} aria-selected={i === 0 ? "true" : "false"}>{g.label}</button>
      ))}
    </div>
    {guides.map((g, i) => (
      <div class:list={["g-panel", "guide-panel", { active: i === 0 }]} data-panel-group="guide" data-panel={g.id}>
        <p class="guide-desc">{g.desc}</p>
        <Code code={g.code} lang="bash" frame="none" />
        <p class="guide-note">{g.note}</p>
      </div>
    ))}
  </section>

  <!-- ============ gridline-framed, Supabase-style sections ============ -->
  <div class="ed">
    <!-- 01 · SCAN -->
    <div class="ed-rule" data-reveal><span class="ed-plus ed-plus-l">+</span><span class="ed-plus ed-plus-r">+</span></div>
    <section class="ed-step">
      <div class="ed-head">
        <div class="ed-label" data-reveal>[ 01 / 03 ]&nbsp;&nbsp;SCAN</div>
        <h2 class="ed-title" data-reveal>Point it at<br /><span class="sc-accent">anything you ship</span></h2>
        <p class="ed-lead" data-reveal>A running app, a code repo, a CI pipeline — Scout finds the ways in from the same single binary.</p>
      </div>
      <div class="ed-cards" data-reveal>
        {capabilities.map((c) => (
          <div class="ed-card">
            <span class="ed-card-ic" set:html={icon(c.icon)} />
            <h3 class="ed-card-title">{c.title}</h3>
            <p class="ed-card-body">{c.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 02 · INSTALL -->
    <div class="ed-rule" data-reveal><span class="ed-plus ed-plus-l">+</span><span class="ed-plus ed-plus-r">+</span></div>
    <section class="ed-step">
      <div class="ed-head">
        <div class="ed-label" data-reveal>[ 02 / 03 ]&nbsp;&nbsp;INSTALL</div>
        <h2 class="ed-title" data-reveal>Up and running<br /><span class="sc-accent">in one line</span></h2>
        <p class="ed-lead" data-reveal>A single Go binary, no runtime and no account — on macOS, Linux and Windows. Then scan with <code>--serve</code> to open the dashboard.</p>
      </div>
      <div class="ed-panel" data-reveal>
        <div class="sc-install">
          <div class="sc-tabs" role="tablist" aria-label="Install Scout">
            {install.map((item, i) => (
              <button type="button" role="tab" class:list={["sc-tab", { active: i === 0 }]} id={`tab-${item.id}`} aria-controls={`panel-${item.id}`} aria-selected={i === 0 ? "true" : "false"} data-tab={item.id}>{item.label}</button>
            ))}
          </div>
          {install.map((item, i) => (
            <div class:list={["sc-panel", { active: i === 0 }]} id={`panel-${item.id}`} role="tabpanel" aria-labelledby={`tab-${item.id}`} data-panel={item.id} data-copy={item.copy ?? item.command}>
              {item.note ? (
                <div class="sc-ai-line"><span class="sc-ai-arrow">{item.command}</span><button type="button" class="sc-copy" data-copy-btn><span data-copy-label>Copy prompt</span></button></div>
              ) : (
                <Code code={item.command} lang="bash" frame="none" />
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 03 · CATCH -->
    <div class="ed-rule" data-reveal><span class="ed-plus ed-plus-l">+</span><span class="ed-plus ed-plus-r">+</span></div>
    <section class="ed-step">
      <div class="ed-head">
        <div class="ed-label" data-reveal>[ 03 / 03 ]&nbsp;&nbsp;CATCH</div>
        <h2 class="ed-title" data-reveal>Finds the ways in,<br /><span class="sc-accent">tells you the fix</span></h2>
        <p class="ed-lead" data-reveal>Dozens of checks across headers, TLS, auth, injection, exposure and your dependencies — each finding carries the evidence and a concrete fix.</p>
      </div>
      <div class="ed-checks" data-reveal>
        {catches.map((c) => (
          <div class="ed-check">
            <span class="ed-check-ic" set:html={icon("check")} />
            <span>{c}</span>
          </div>
        ))}
      </div>
    </section>

    <div class="ed-rule"><span class="ed-plus ed-plus-l">+</span><span class="ed-plus ed-plus-r">+</span></div>
    <div class="ed-cta" data-reveal>
      <a class="sc-btn sc-btn-primary" href="/start/quickstart/">Start scanning</a>
      <a class="ed-link" href="/reference/checks/">Browse the full checks catalog →</a>
    </div>
  </div>
</div>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const COMMAND = "scout scan --target https://example.com";
  const mm = gsap.matchMedia();
  mm.add({ reduce: "(prefers-reduced-motion: reduce)", ok: "(prefers-reduced-motion: no-preference)" }, (ctx) => {
    const reduce = ctx.conditions?.reduce;
    const typed = document.querySelector<HTMLElement>("#sc-typed");
    const caret = document.querySelector<HTMLElement>("#sc-caret");
    const outs = gsap.utils.toArray<HTMLElement>(".sc-out, .sc-findings, .sc-grade-line");
    const score = document.querySelector<HTMLElement>("#sc-score");

    if (reduce) {
      if (typed) typed.textContent = COMMAND;
      if (caret) caret.style.display = "none";
      gsap.set(outs, { autoAlpha: 1, y: 0 });
      document.querySelectorAll<HTMLElement>("[data-anim],[data-reveal]").forEach((el) => gsap.set(el, { autoAlpha: 1, y: 0 }));
      return;
    }
    gsap.from("[data-anim]", { autoAlpha: 0, y: 18, duration: 0.7, ease: "power2.out", stagger: 0.09 });
    const tl = gsap.timeline({ delay: 0.5 });
    const state = { n: 0 };
    tl.to(state, { n: COMMAND.length, duration: 1.1, ease: "none", onUpdate: () => { if (typed) typed.textContent = COMMAND.slice(0, Math.round(state.n)); } });
    tl.to(outs, { autoAlpha: 1, y: 0, duration: 0.3, stagger: 0.22, ease: "power2.out" }, "+=0.15");
    const scoreState = { v: 100 };
    tl.to(scoreState, { v: 17, duration: 0.9, ease: "power1.out", snap: { v: 1 }, onUpdate: () => { if (score) score.textContent = Math.round(scoreState.v) + "/100"; } }, ">-0.5");
    gsap.to(caret, { autoAlpha: 0, duration: 0.5, repeat: -1, yoyo: true, ease: "steps(1)" });
    gsap.utils.toArray<HTMLElement>("[data-reveal]").forEach((el) => {
      gsap.from(el, { autoAlpha: 0, y: 22, duration: 0.6, ease: "power2.out", scrollTrigger: { trigger: el, start: "top 90%" } });
    });
  });

  document.querySelectorAll<HTMLElement>(".sc-tab").forEach((tab) => {
    tab.addEventListener("click", () => {
      const id = tab.dataset.tab;
      document.querySelectorAll<HTMLElement>(".sc-tab").forEach((t) => { const on = t === tab; t.classList.toggle("active", on); t.setAttribute("aria-selected", on ? "true" : "false"); });
      document.querySelectorAll<HTMLElement>(".sc-panel").forEach((p) => { p.classList.toggle("active", p.dataset.panel === id); });
    });
  });

  // Generic tab groups: the dashboard gallery and the how-to-scan guide.
  document.querySelectorAll<HTMLElement>("[data-tab-group]").forEach((tab) => {
    tab.addEventListener("click", () => {
      const group = tab.dataset.tabGroup;
      const id = tab.dataset.tab;
      document.querySelectorAll<HTMLElement>(`[data-tab-group="${group}"]`).forEach((t) => {
        const on = t === tab;
        t.classList.toggle("active", on);
        t.setAttribute("aria-selected", on ? "true" : "false");
      });
      document.querySelectorAll<HTMLElement>(`[data-panel-group="${group}"]`).forEach((p) => {
        p.classList.toggle("active", p.dataset.panel === id);
      });
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-copy-btn]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const panel = btn.closest<HTMLElement>(".sc-panel");
      const text = panel?.dataset.copy ?? "";
      const label = btn.querySelector<HTMLElement>("[data-copy-label]");
      const say = (m: string) => { if (label) label.textContent = m; window.setTimeout(() => { if (label) label.textContent = "Copy prompt"; }, 2000); };
      try { await navigator.clipboard.writeText(text); say("Copied"); } catch { say("Press Ctrl+C"); }
    });
  });
</script>

<style>
  :global(main h1#_top) { display: none; }
  :global(.content-panel:first-of-type) { border-top: 0; }

  .sc-root { --sc-ring: color-mix(in srgb, var(--fl-ember) 32%, transparent); --sc-crit: #ef4444; --sc-high: #f59e0b; --sc-med: #eab308; position: relative; isolation: isolate; }

  /* background — subtle, Supabase-clean */
  .sc-bg { position: absolute; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
  .sc-grid { position: absolute; inset: -2px; background-image: linear-gradient(to right, color-mix(in srgb, var(--fl-ember) 7%, transparent) 1px, transparent 1px), linear-gradient(to bottom, color-mix(in srgb, var(--fl-ember) 7%, transparent) 1px, transparent 1px); background-size: 48px 48px; -webkit-mask-image: radial-gradient(ellipse 75% 50% at 65% 0%, #000 0%, transparent 72%); mask-image: radial-gradient(ellipse 75% 50% at 65% 0%, #000 0%, transparent 72%); }
  .sc-glow { position: absolute; width: 40rem; height: 40rem; top: -16rem; right: -8rem; border-radius: 50%; filter: blur(80px); opacity: 0.4; background: radial-gradient(circle, color-mix(in srgb, var(--fl-ember) 34%, transparent), transparent 70%); }

  /* hero */
  .sc-hero { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 3rem; align-items: center; max-width: 72rem; margin: 0 auto; padding: 4.5rem var(--gutter, 1.5rem) 3.5rem; }
  .sc-hero-copy { text-align: left; }
  .sc-pill { display: inline-flex; align-items: center; gap: 0.5rem; max-width: 100%; padding: 0.3rem 0.8rem 0.3rem 0.3rem; border: 1px solid var(--fl-rule); border-radius: 999px; background: color-mix(in srgb, var(--fl-surface) 80%, transparent); backdrop-filter: blur(6px); font-size: 0.8rem; color: var(--fl-muted); text-decoration: none; transition: border-color 0.15s ease; }
  .sc-pill:hover { border-color: var(--fl-ember); }
  .sc-pill-tag { font-family: var(--sl-font-mono); font-size: 0.68rem; font-weight: 600; padding: 0.2rem 0.5rem; border-radius: 999px; background: var(--fl-ember); color: var(--fl-on-ember); }
  .sc-pill-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sc-title { margin: 1.5rem 0 0; font-size: clamp(2.4rem, 1.4rem + 3.4vw, 3.9rem); font-weight: 680; line-height: 1.04; letter-spacing: -0.04em; color: var(--fl-ink); }
  .sc-accent { display: block; color: var(--fl-ember-strong); }
  :root:not([data-theme="light"]) .sc-accent { color: var(--fl-ember); }
  .sc-sub { max-width: 34rem; margin: 1.35rem 0 0; font-size: 1.05rem; line-height: 1.6; color: var(--fl-muted); }
  .sc-demo { margin: 1.1rem 0 0; font-size: 0.9rem; color: var(--fl-muted); }
